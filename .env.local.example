# Supabase — get from supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]

# OpenAI — get from platform.openai.com → API Keys
# Required for: photo extraction, asset classification, description generation
OPENAI_API_KEY=sk-...

# Salesforce OAuth — External Client App credentials (from IT / Julian McEvoy)
# Required for: Salesforce push on the output page
SALESFORCE_CLIENT_ID=[Consumer Key]
SALESFORCE_CLIENT_SECRET=[Consumer Secret]
SALESFORCE_REDIRECT_URI=https://assetbookintool.com/api/auth/salesforce/callback
